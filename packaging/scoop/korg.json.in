{
    "version": "@VERSION@",
    "description": "Kirby's music organizer: covers, synced lyrics, FLAC to Opus, ReplayGain",
    "homepage": "https://github.com/archhaze24/korg",
    "license": "MIT",
    "notes": "korg needs opusenc and rsgain in PATH, and an rsgain preset named opus. See https://github.com/archhaze24/korg#requirements",
    "architecture": {
        "64bit": {
            "url": "https://github.com/archhaze24/korg/releases/download/@TAG@/korg-@TAG@-x86_64-pc-windows-msvc.zip",
            "hash": "@SHA_x86_64_pc_windows_msvc@",
            "extract_dir": "korg-@TAG@-x86_64-pc-windows-msvc"
        }
    },
    "bin": "korg.exe",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/archhaze24/korg/releases/download/v$version/korg-v$version-x86_64-pc-windows-msvc.zip",
                "hash": {
                    "url": "$url.sha256"
                },
                "extract_dir": "korg-v$version-x86_64-pc-windows-msvc"
            }
        }
    }
}
